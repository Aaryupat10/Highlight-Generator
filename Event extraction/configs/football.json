    "\\bequali[sz](?:es|ed|ing|er)\\b",
    "\\bmak(?:es|ing) it (?:\\d|one|two|three|four|five)",
    "\\bopen(?:s|ed|ing) the scoring\\b",
    "\\b(?:doubles|doubled|trebles|extends|extended|restores|restored|halves|halved)\\s+(?:the|their|his|its)\\s+(?:lead|advantage|deficit)\\b",
    "\\bpull(?:s|ed|ing)? (?:one|a goal) back\\b",
    "\\blevel(?:s|led|ed)\\s+(?:the\\s+)?(?:score|scores|game|match|tie)\\b",
    "\\bdraws? (?:\\w+ )?level\\b",
    "\\bcancel(?:s|led|ling)? out\\b",
    "\\bput(?:s|ting)?\\s+(?:@E|\\w+)\\s+(?:ahead|in front)\\b",
    "\\b(?:poke|tap|slot|roll|bundle|head|nod|fire|smash|tuck|steer|guide|drill|lash|curl|sweep|stab|prod|convert|finish|bury|sidefoot|lift|lob|rifle|blast|power|slide|squeeze|dink|clip|arrow|thump|stroke|knock|ram|hammer|plant|fizz|volley|loop|flick|bend|work|force|turn)(?:s|es|ed|d|ing)?\\b[^.!?,;]{0,30}?(?:\\bhome\\b|into the (?:\\w+ ){0,2}(?:net|corner|roof of the net)|past @P)",
    "\\bput(?:s|ting)?\\s+[^.!?,;]{0,30}?\\d-\\d\\s+(?:up|ahead)\\b",
    "\\b(?:convert(?:s|ed)|dispatch(?:es|ed)|bur(?:ies|ied)|tuck(?:s|ed) away)\\s+(?:the|his|a|their)\\s+(?:penalty|spot-kick|chance)",
    "^\\s*\\d{1,2}\\s*-\\s*\\d{1,2}\\s+(?:@T\\d+|[A-Z][A-Z .']+)[!.\\s]*$"
   ],
   "exclude": [
    "\\b(?:has|have|had|having|not|never|ever|yet to|hasn't|haven't) (?:\\w+ )?scor(?:ed|ing)",
