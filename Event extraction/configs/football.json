{
 "sport": "football",
 "classes": [
  "goal",
  "card",
  "near_miss",
  "foul",
  "routine"
 ],
 "possessive_pronouns": [
  "his",
  "her",
  "their",
  "its",
  "whose"
 ],
 "max_gap_words": 8,
 "short_sentence_words": 3,
 "clause_breakers": "\\b(?:but|though|although|however|while|whereas|yet|so|as)\\b|[;:\\u2014]|\\s-\\s",
 "non_subject_prepositions": [
  "to",
  "for",
  "by",
  "from",
  "against",
  "past",
  "through",
  "around",
  "between",
  "over",
  "on",
  "beyond",
  "behind",
  "via",
  "with"
 ],
 "context_markers": [
  "\\bxG\\b",
  "expected goals",
  "head[- ]to[- ]head",
  "\\bprevious (?:meeting|meetings|encounter|encounters|fixture|game|match|season)\\b",
  "\\blast (?:season|time|year|week|month|term|campaign)\\b",
  "\\bthis (?:season|term|campaign)\\b",
  "\\bso far (?:this|today|in)\\b",
  "\\bunbeaten\\b",
  "\\bsince (?:the|he|they|his|their|August|September|October|November|December|January|February|March|April|May|\\d{4})\\b",
  "\\b(?:\\d+|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve) (?:shots|saves|corners|goals|points|games|matches|appearances|clean sheets|wins|defeats|league goals)\\b",
  "\\bstarting (?:XI|line-?up)\\b",
  "\\bteam news\\b",
  "\\bpreview\\b",
  "\\bwelcome to\\b",
  "\\bgood (?:morning|afternoon|evening)\\b",
  "^hello\\b",
  "\\bleague table\\b",
  "\\bstandings\\b",
  "\\bnamed (?:in|on|as)\\b",
  "\\bon the bench\\b",
  "\\bsuspension\\b",
  "\\bout (?:injured|with)\\b",
  "\\bunavailable\\b",
  "\\bsuspended\\b",
  "\\b(?:one|two|three)-match ban\\b",
  "\\bprevious outing\\b",
  "\\bin their (?:last|previous)\\b",
  "\\bpre-?match\\b",
  "\\bwho (?:has|have) (?:scored|won)\\b",
  "\\b(?:was|were|had been) (?:booked|sent off|dismissed) (?:in|on|at|during|against)\\b"
 ],
 "live_markers": [
  "^[A-Z][A-Z'\\u2019.\\- ]{2,}[!?]",
  "\\bGO+A+L+\\b",
  "\\bFULL[- ]TIME\\b",
  "\\bHALF[- ]TIME\\b"
 ],
 "modality": [
  {
   "label": "negated",
   "regex": "\\b(?:no|not|never|without|fails? to|failed to|unable to|can(?:'|\\u2019)?t|cannot|couldn(?:'|\\u2019)?t|doesn(?:'|\\u2019)?t|didn(?:'|\\u2019)?t|won(?:'|\\u2019)?t|isn(?:'|\\u2019)?t|wasn(?:'|\\u2019)?t|hasn(?:'|\\u2019)?t)\\s+(?:[\\w'@\\u2019-]+\\s+){0,4}$"
  },
  {
   "label": "appeal",
   "regex": "\\b(?:appeal(?:s|ed|ing)? for|appeals|shouts? for|shout for|claims? for|claim a|calls? for|called for|wants?|wanted|demands?|pleads? for|screams? for|claim|appealing)\\s+(?:[\\w'@\\u2019-]+\\s+){0,4}$"
  },
  {
   "label": "attempted",
   "regex": "\\b(?:tries to|tried to|trying to|attempts? to|attempted to|looks? to|looked to|looking to|has a go at|wants? to)\\s+(?:[\\w'@\\u2019-]+\\s+){0,4}$"
  },
  {
   "label": "unrealised",
   "regex": "\\b(?:almost|nearly|just about|inches from|threaten(?:s|ed)? to|about to|thought (?:he|they|it|she)|thinks? (?:he|they)|could have|would have|might have|should have|could|might|would)\\s+(?:[\\w'@\\u2019-]+\\s+){0,4}$"
  },
  {
   "label": "hypothetical",
   "regex": "\\b(?:if|whether|unless)\\s+(?:[\\w'@\\u2019-]+\\s+){0,4}$"
  }
 ],
 "new_subject_markers": ",\\s+(?:and\\s+)?(?:a|an|the|another|some|one)\\b",
 "method_skip_events": [
  "var_check",
  "kick_off",
  "half_time",
  "full_time",
  "offside",
  "substitution",
  "injury",
  "foul",
  "yellow_card",
  "red_card",
  "penalty_awarded",
  "goal_disallowed"
 ],
 "recap_start": [
  {
   "regex": "^HALF[- ]TIME\\b",
   "max_lines": 12
  },
  {
   "regex": "^FULL[- ]TIME\\b",
   "max_lines": 60
  }
 ],
 "recap_end": [
  "\\bunder ?way\\b",
  "\\bball rolling\\b",
  "\\bsecond half (?:is |gets )?(?:under|started|begins|begun|kicks|off)",
  "\\bkick(?:s|ed)? off the second\\b",
  "\\b(?:get|gets|getting)\\b[^.!?]{0,25}\\bback\\b"
 ],
 "prematch_end": [
  "\\bgets?\\b[^.!?]{0,40}?\\bunder ?way\\b(?! with)",
  "\\bkick(?:s|ed)? (?:us |things |the game |the match |proceedings )?off\\b(?! (?:the|their|his|its|a|this|time|at|in|is|will))",
  "\\bwe(?:'re| are) (?:now )?under ?way\\b",
  "\\bkicking off\\b",
  "(?-i:\\bPEEP\\b)"
 ],
 "prematch_search_lines": 60,
 "suppress": {
  "goal_disallowed": [
   "goal"
  ],
  "goal": [
   "shot",
   "chance",
   "woodwork"
  ],
  "woodwork": [
   "shot"
  ],
  "save": [
   "shot"
  ],
  "penalty_miss": [
   "save",
   "shot",
   "penalty"
  ]
 },
 "outcome_from_event": {
  "save": "saved",
  "block": "blocked",
  "woodwork": "hit_woodwork"
 },
